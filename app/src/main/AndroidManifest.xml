<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Разрешений ровно четыре. Ни фона, ни уведомлений, ни записи в хранилище:
         приложение работает только пока открыто. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- targetSdk 30+ прячет чужие пакеты. Без этого списка кнопка «открыть
         приложение сети» и выбор навигатора молча ничего не находят. -->
    <queries>
        <package android:name="kg.spark.main" />
        <package android:name="tech.weway.app.kg" />
        <package android:name="kg.evion.app" />
        <package android:name="com.pay24.charge24" />
        <package android:name="kg.redpay" />
        <package android:name="ru.dublgis.dgismobile" />
        <package android:name="ru.yandex.yandexnavi" />
        <package android:name="ru.yandex.yandexmaps" />
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".ChargeKgApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.ChargeKG">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ChargeKG">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Собственная схема: работает всегда, без проверки владения доменом. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="chargekg" android:host="station" />
            </intent-filter>

            <!-- App Link на сайт. autoVerify требует assetlinks.json на chargekg.com;
                 пока его нет, ссылка откроется через диалог выбора — это не ошибка. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="chargekg.com" android:pathPrefix="/s/" />
            </intent-filter>
        </activity>

        <!-- Отдаёт скачанный APK установщику: прямой file:// с Android 7 запрещён. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
