<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Вся тема живёт в Compose (ui/Theme.kt). XML-тема нужна только чтобы
         окно не мигало белым до первого кадра и чтобы работал AppCompatDelegate
         с per-app language. -->
    <style name="Theme.ChargeKG" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
